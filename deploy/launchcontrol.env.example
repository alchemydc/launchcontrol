# launchcontrol deployment env — copy to deploy/launchcontrol.env and edit.
# (Example values below configure the RMsolo league; swap for your club.)
# (deploy/launchcontrol.env is gitignored; never commit real secrets.)

SITE_TITLE=Launch Control · RM Solo
SITE_DESCRIPTION=Rocky Mountain Solo autocross results and season standings.
FOOTER_TEXT=Rocky Mountain Solo · Results scraped from rmsolo.org

# Public results; login offered only once MSR credentials are configured.
ACCESS_GATE=optional
# Overall PAX standings (season section + event-page view) and
# run-group indexed ordering.
PAX_STANDINGS=1
# 2026 Summer Series: 10 planned events, best-6 final scoring.
PLANNED_SEASON_EVENTS=2026:10
# Drops scale with season progress (best 3 of 5 at half season).
SEASON_DROPS=proportional

# How often the ingest sidecar polls rmsolo.org (seconds). Default every 30 minutes.
INGEST_INTERVAL_SECONDS=1800

# --- Optional: MSR login (leave unset until org-scoped credentials exist) ---
# MSR_CONSUMER_KEY=
# MSR_CONSUMER_SECRET=
# MSR_ORG_ID=
# MSR_OAUTH_CALLBACK_URL=https://your-host/api/auth/msr/callback
# SESSION_SECRET=   # 32+ random chars; required only if MSR login is enabled
# ADMIN_MSR_UIDS=
