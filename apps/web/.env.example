# Local dev default — no Turso credentials needed for local development.
DATABASE_URL=file:./dev.db

# If TURSO_DATABASE_URL is set, the app uses Turso (libSQL) instead of DATABASE_URL.
# Leave blank for local dev; set both in Vercel env vars for preview/prod.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# SmugMug photo album lookup (optional — photos link hidden if unset)
SMUGMUG_API_KEY=
SMUGMUG_USER=rmrpca
SMUGMUG_DISCIPLINE_PATH=Autocross

# MSR
MSR_CONSUMER_KEY=
MSR_CONSUMER_SECRET=
MSR_RMR_ORG_ID=
MSR_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/msr/callback
# Iron-session encryption key (32+ random bytes, base64 or hex)
# Unnecessary for a fully public deployment (ACCESS_GATE=none); required otherwise.
SESSION_SECRET=
# Comma-separated MSR UIDs allowed to access /admin and POST /api/admin/ingest
ADMIN_MSR_UIDS=

# --- Club configuration (defaults reproduce the PCA RMR deployment) ---
# SITE_TITLE="Launch Control · PCA RMR"
# SITE_DESCRIPTION=
# FOOTER_TEXT=
# LANDING_DESCRIPTION=
# ACCESS_GATE=required   # required | optional | none
# NAME_DISPLAY=initial   # initial | full
# Enable overall-PAX standings (season leaderboard section + event-page view; RMsolo: 1).
# PAX_STANDINGS=0
# Per-year planned event counts, overriding the built-in PCA map (RMsolo 2026: "2026:10").
# Drops fall out automatically: best floor(N/2)+1 scores count.
# PLANNED_SEASON_EVENTS=
# fixed (default): mid-season nothing drops until the qualifying threshold is exceeded.
# proportional (RMsolo): drops scale with completed events — best 3 of 5 at half season, best 6 of 10 final.
# SEASON_DROPS=fixed
# Preferred generic org var; MSR_RMR_ORG_ID still honored as a legacy alias.
# MSR_ORG_ID=
