# Local dev default — no Turso credentials needed for local development.
DATABASE_URL=file:./dev.db

# If TURSO_DATABASE_URL is set, the app uses Turso (libSQL) instead of DATABASE_URL.
# Leave blank for local dev; set both in Vercel env vars for preview/prod.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Selects which League row this deployment serves (League/Season/ScoringSystem
# config lives in the DB, not env — see README.md "Leagues & Seasons"). Leave
# unset for the default PCA RMR deployment.
# DEFAULT_LEAGUE_SLUG=pca-rmr

# SmugMug photo album lookup (optional — photos link hidden if unset).
# SMUGMUG_USER / SMUGMUG_DISCIPLINE_PATH are DB-first: the deployment's League
# row wins when set, and these only apply as a fallback for a League row that
# leaves the field null (rmrpca/Autocross below matches the seeded pca-rmr row).
SMUGMUG_API_KEY=
SMUGMUG_USER=rmrpca
SMUGMUG_DISCIPLINE_PATH=Autocross

# MSR
MSR_CONSUMER_KEY=
MSR_CONSUMER_SECRET=
# Legacy fallback for League.msrOrgId — only applies when the League row leaves msrOrgId null.
MSR_RMR_ORG_ID=
MSR_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/msr/callback
# Iron-session encryption key (32+ random bytes, base64 or hex)
SESSION_SECRET=
# Comma-separated MSR UIDs allowed to access /admin and POST /api/admin/ingest
ADMIN_MSR_UIDS=
