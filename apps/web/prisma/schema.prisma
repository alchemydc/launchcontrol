// PCA Launch Control — app database
// See docs/PRD.md §2.4 for the source of truth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id           Int      @id @default(autoincrement())
  seasonId     Int
  msrEventId   String?
  slug         String
  name         String
  date         DateTime
  location     String?
  sourceSha256 String? // sha256 of the ingested source artifact (.axdb file or results PDF) — idempotency key
  createdAt    DateTime @default(now())

  season  Season  @relation(fields: [seasonId], references: [id])
  entries Entry[]
  videos  Video[]

  @@unique([seasonId, msrEventId])
  @@unique([seasonId, slug])
  @@unique([seasonId, sourceSha256])
  @@index([seasonId])
}

model Driver {
  id          Int     @id @default(autoincrement())
  msrUid      String? @unique
  firstName    String
  lastInitial  String  // single uppercase letter + period (e.g. "K."), never the full last name — enforced in ingest.ts redactLastName()
  identityHash String  @unique
  memberNum    String?
  nameOnlyHash String?   // sha256(lower(first)|lower(last)) — full-name key for blank-member merging at ingest; nullable because pre-existing rows can't be backfilled (full surname is never stored)

  entries Entry[]
  videos  Video[]

  @@index([nameOnlyHash])
}

model CarClass {
  id       Int     @id @default(autoincrement())
  leagueId Int
  code     String
  paxIndex Decimal @default(1.0000)

  league         League  @relation(fields: [leagueId], references: [id])
  enteredEntries Entry[] @relation("EnteredClass")
  paxEntries     Entry[] @relation("PaxClass")

  @@unique([leagueId, code])
}

model Entry {
  id             Int     @id @default(autoincrement())
  eventId        Int
  driverId       Int
  classId        Int
  paxClassId     Int
  carNumber              String
  carDescription         String?
  bestCommittedRunNumber Int?    // VisualAX-authoritative best-run pointer; resolved from registrations.bestcommittedrun_id by finding the FK's position in the driver's sorted-by-id source runs (1-indexed). Null when VisualAX emits no committed best.

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  class    CarClass @relation("EnteredClass", fields: [classId], references: [id])
  paxClass CarClass @relation("PaxClass", fields: [paxClassId], references: [id])
  runs     Run[]

  // No @@unique on (eventId, driverId): a driver can enter the same event
  // multiple times via co-drives or multi-class entries.
  @@index([eventId])
  @@index([driverId])
}

enum RunDisposition {
  CLEAN
  DNF
  RRN
  OFF
  DSQ
}

model Run {
  id          Int            @id @default(autoincrement())
  entryId     Int
  runNumber   Int
  rawTimeMs   Int?
  cones       Int            @default(0)
  disposition RunDisposition @default(CLEAN)

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, runNumber])
  @@index([entryId])
}

model Video {
  id          Int      @id @default(autoincrement())
  eventId     Int
  driverId    Int
  url         String
  runGroup    String?
  carClass    String?
  description String?
  createdAt   DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model League {
  id                    Int      @id @default(autoincrement())
  slug                  String   @unique
  name                  String
  siteTitle             String
  siteDescription       String
  footerText            String?
  landingDescription    String
  accessGate            String   @default("required") // "required" | "optional" | "none"
  msrOrgId              String?
  smugmugUser           String?
  smugmugDisciplinePath String?
  logoUrl               String?
  createdAt             DateTime @default(now())

  seasons        Season[]
  scoringSystems ScoringSystem[]
  memberships    LeagueMembership[]
  carClasses     CarClass[]
}

model ScoringSystem {
  id        Int      @id @default(autoincrement())
  leagueId  Int
  name      String
  policy    String // JSON ScoringPolicy v1 (SQLite has no JSON type)
  createdAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, name])
}

model Season {
  id            Int    @id @default(autoincrement())
  leagueId      Int
  name          String
  slug          String // URL-safe addressing key — slugify(name) unless overridden via --slug
  year          Int
  plannedEvents Int    @default(0)
  scoringPolicy String // JSON snapshot — copied from a ScoringSystem, never a live reference
  paxTable      String @default("{}") // JSON code->factor for this season
  status        String @default("active") // "active" | "completed"

  league League  @relation(fields: [leagueId], references: [id])
  events Event[]

  @@unique([leagueId, name])
  @@unique([leagueId, slug])
  @@index([leagueId, year])
}

model LeagueMembership {
  id       Int    @id @default(autoincrement())
  leagueId Int
  msrUid   String
  role     String // "ADMIN" | "MEMBER"

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, msrUid])
}

model SuperUser {
  id        Int      @id @default(autoincrement())
  msrUid    String   @unique
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  action      String   // "ingest" | "event.update" | "event.delete"
  actorMsrUid String   // MSR UID, or "cli" for scripts/ingest.ts
  actorName   String   // "First L." only — NEVER full last name (PII rule)
  targetType  String   // "event"
  targetId    Int?
  targetSlug  String?
  detail      String   // JSON string (SQLite has no native JSON type)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
